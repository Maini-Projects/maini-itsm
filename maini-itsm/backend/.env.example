# Copy to .env for local runs. On Render, enter these in the service's Environment tab instead.
# NEVER commit the real .env, and never paste the service-role key into chat or into the front end.

# Supabase > Project Settings > Database > Connection string.
# Use the "Session pooler" string (works from Render over IPv4). If the password has special
# characters such as @ # / : they must be URL-encoded in this string.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key>
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>

# Front-end addresses allowed to call this API from a browser, comma separated
CORS_ORIGINS=http://localhost:5173

# Optional
# DB_POOL_MAX=5
# TOKEN_CACHE_SECONDS=30
